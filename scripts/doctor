#!/usr/bin/env bash
set -euo pipefail

script_dir="${BASH_SOURCE[0]%/*}"
# shellcheck disable=SC1091 # The script resolves this source relative to its own path.
# shellcheck source=scripts/lib/common
source "${script_dir}/lib/common"

check_architecture() {
  local arch
  arch="$(uname -m)"
  [ "$arch" = "x86_64" ] || fail "unsupported architecture $arch; expected x86_64"
}

check_commands() {
  need_command virsh "libvirt-client"
  need_command qemu-system-x86_64 "qemu-system-x86-core"
  need_command qemu-img "qemu-img"
  need_command uuidgen "util-linux-core"
  need_command uv "uv"
  need_command curl "curl"
  need_command timeout "coreutils"
  need_command openssl "openssl"
  need_command htpasswd "httpd-tools"
  need_command gcc "gcc"
  need_command pkg-config "pkgconf-pkg-config"
  need_command bats "bats"
  need_command shellcheck "ShellCheck"
  need_command shfmt "shfmt"
  need_command grub2-mkrescue "grub2-tools-extra"
  need_command xorriso "xorriso"
}

matching_kernel_image() {
  local kernel_release="$1"
  local candidate
  if [ -n "${VM_X86_REDFISH_TEST_KERNEL_IMAGE:-}" ]; then
    printf '%s\n' "$VM_X86_REDFISH_TEST_KERNEL_IMAGE"
    return
  fi
  for candidate in \
    "/usr/lib/modules/${kernel_release}/vmlinuz" \
    "/lib/modules/${kernel_release}/vmlinuz" \
    "/boot/vmlinuz-${kernel_release}"; do
    if [ -e "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done
  printf '/boot/vmlinuz-%s\n' "$kernel_release"
}

matching_kernel_config() {
  local kernel_release="$1"
  if [ -n "${VM_X86_REDFISH_TEST_KERNEL_CONFIG:-}" ]; then
    printf '%s\n' "$VM_X86_REDFISH_TEST_KERNEL_CONFIG"
  else
    printf '/boot/config-%s\n' "$kernel_release"
  fi
}

require_kernel_capability() {
  local config_path="$1"
  local kernel_release="$2"
  local capability="$3"
  grep -Fx "${capability}=y" "$config_path" >/dev/null ||
    fail "kernel $kernel_release lacks ${capability}=y required by NMI fixture;" \
      "install kernel-core-$kernel_release with $capability enabled"
}

check_nmi_fixture_prerequisites() {
  local config_path
  local kernel_path
  local kernel_release
  if ! integration_override_enabled; then
    return 0
  fi

  kernel_release="$(uname -r)"
  command -v cpio >/dev/null 2>&1 ||
    fail "missing command 'cpio' for NMI fixture kernel $kernel_release: install cpio"
  kernel_path="$(matching_kernel_image "$kernel_release")"
  if [ ! -r "$kernel_path" ]; then
    fail "matching kernel $kernel_release is not readable at $kernel_path;" \
      "install kernel-core-$kernel_release"
  fi
  config_path="$(matching_kernel_config "$kernel_release")"
  if [ ! -r "$config_path" ]; then
    fail "kernel config for $kernel_release is not readable at $config_path;" \
      "install kernel-core-$kernel_release"
  fi
  require_kernel_capability "$config_path" "$kernel_release" CONFIG_X86_64
  require_kernel_capability "$config_path" "$kernel_release" CONFIG_HAVE_NMI
  require_kernel_capability "$config_path" "$kernel_release" CONFIG_BLK_DEV_INITRD
  require_kernel_capability "$config_path" "$kernel_release" CONFIG_PROC_FS
  require_kernel_capability "$config_path" "$kernel_release" CONFIG_BINFMT_ELF
  require_kernel_capability "$config_path" "$kernel_release" CONFIG_SERIAL_8250_CONSOLE
  printf 'int main(void) { return 0; }\n' |
    gcc -static -x c -o /dev/null - >/dev/null 2>&1 ||
    fail "gcc cannot link a static PID 1 for kernel $kernel_release: install glibc-static"
}

check_libvirt() {
  local version
  virsh -c "$LIBVIRT_URI" uri >/dev/null ||
    fail "cannot connect to $LIBVIRT_URI: enable libvirtd and grant access"
  version="$(virsh -c "$LIBVIRT_URI" version)"
  printf '%s\n' "$version" | grep -F "Using library: libvirt 12.0." >/dev/null ||
    fail "unsupported libvirt version: expected 12.0.x"
  require_active_network
  require_running_pool
}

require_active_network() {
  local info
  info="$(virsh -c "$LIBVIRT_URI" net-info default)" ||
    fail "libvirt default network is unavailable: define it before running create"
  printf '%s\n' "$info" | grep -E '^Active:[[:space:]]+yes$' >/dev/null ||
    fail "libvirt default network is inactive: start it with virsh net-start default"
}

require_running_pool() {
  local info
  info="$(virsh -c "$LIBVIRT_URI" pool-info "$STORAGE_POOL")" ||
    fail "libvirt storage pool '$STORAGE_POOL' is unavailable"
  printf '%s\n' "$info" | grep -E '^State:[[:space:]]+running$' >/dev/null ||
    fail "libvirt storage pool '$STORAGE_POOL' is not running"
}

kvm_device_path() {
  if integration_override_enabled && [ -n "${VM_X86_REDFISH_DEV_KVM:-}" ]; then
    printf '%s\n' "$VM_X86_REDFISH_DEV_KVM"
  else
    printf '/dev/kvm\n'
  fi
}

ovmf_dir_path() {
  if integration_override_enabled && [ -n "${VM_X86_REDFISH_OVMF_DIR:-}" ]; then
    printf '%s\n' "$VM_X86_REDFISH_OVMF_DIR"
  elif [ -d /usr/share/edk2/ovmf ]; then
    printf '/usr/share/edk2/ovmf\n'
  else
    printf '/usr/share/OVMF\n'
  fi
}

check_kvm() {
  local kvm_path
  kvm_path="$(kvm_device_path)"
  [ -e "$kvm_path" ] || fail "missing $kvm_path: enable KVM virtualization"
  if [ ! -r "$kvm_path" ] || [ ! -w "$kvm_path" ]; then
    fail "cannot read and write $kvm_path: add the user to the kvm group"
  fi
}

check_uefi_firmware() {
  local ovmf_dir
  ovmf_dir="$(ovmf_dir_path)"
  [ -d "$ovmf_dir" ] || fail "missing UEFI firmware: install edk2-ovmf"
}

check_uv_python() {
  local python_bin
  python_bin="$(python_313)"
  "$python_bin" - <<'PY' || fail "uv must provide Python 3.13"
import sys
raise SystemExit(0 if sys.version_info[:2] == (3, 13) else 1)
PY
}

check_native_build_inputs() {
  local python_bin
  pkg-config --exists libvirt ||
    fail "missing libvirt development headers: install libvirt-devel"
  python_bin="$(python_313)"
  "$python_bin" - <<'PY' || fail "missing Python 3.13 headers: install python3-devel"
import pathlib
import sysconfig
include = sysconfig.get_config_var("INCLUDEPY")
raise SystemExit(0 if include and (pathlib.Path(include) / "Python.h").is_file() else 1)
PY
}

check_configured_listeners() {
  reject_listener_collision
  check_listener_available "$REDFISH_LISTEN_IP" "$REDFISH_LISTEN_PORT"
  if [ "$SERIAL_MODE" = "tcp" ]; then
    check_listener_available "$SERIAL_LISTEN_IP" "$SERIAL_LISTEN_PORT"
  fi
}

check_architecture
check_commands
check_nmi_fixture_prerequisites
check_kvm
check_uefi_firmware
check_uv_python
check_native_build_inputs
warn_network_exposure
check_configured_listeners
check_libvirt
print_effective_endpoints 'doctor: '
printf 'doctor: host prerequisites are available\n'
