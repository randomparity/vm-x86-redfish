#!/usr/bin/env bash
# shellcheck disable=SC2034 # Sourced lifecycle scripts consume these shared globals.
set -euo pipefail

PROJECT_NAME="vm-x86-redfish"
DEFAULT_DOMAIN_NAME="vm-x86-redfish"
LIBVIRT_URI="qemu:///system"
STORAGE_POOL="default"
STATE_DIR=".state"
ARTIFACTS_DIR=".artifacts"
ROOT_VOLUME_NAME="vm-x86-redfish.qcow2"
MEMORY_MIB="4096"
ROOT_DISK_GIB="40"
SOURCE_IMAGE=""
SOURCE_IMAGE_SHA256=""
REDFISH_LISTEN_IP="127.0.0.1"
REDFISH_LISTEN_PORT="8000"
SERIAL_MODE="pty"
SERIAL_LISTEN_IP=""
SERIAL_LISTEN_PORT=""
DOMAIN_UUID_FILE="${STATE_DIR}/domain-uuid"
LIFECYCLE_LOCK="${STATE_DIR}/lifecycle.lock"

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command '$1': install $2"
}

python_313() {
  UV_PYTHON_DOWNLOADS=never uv python find 3.13 2>/dev/null ||
    fail "uv must find Python 3.13 without downloading"
}

integration_override_enabled() {
  [ "${VM_X86_REDFISH_INTEGRATION_TEST:-}" = "1" ]
}

reject_unguarded_override() {
  local name="$1"
  if [ -n "${!name:-}" ] && ! integration_override_enabled; then
    fail "test-only overrides require VM_X86_REDFISH_INTEGRATION_TEST=1"
  fi
}

canonical_ip_address() {
  local address="$2"
  local canonical_address
  local python_bin
  local variable="$1"
  python_bin="$(python_313)"
  if ! canonical_address="$(
    "$python_bin" - "$address" <<'PY'
import ipaddress
import sys

try:
    parsed = ipaddress.ip_address(sys.argv[1])
except ValueError:
    raise SystemExit(1)

if parsed.is_unspecified or parsed.is_multicast or getattr(parsed, "scope_id", None) is not None:
    raise SystemExit(1)

print(parsed)
PY
  )"; then
    fail "$variable must be a concrete unicast IP address"
  fi
  printf '%s\n' "$canonical_address"
}

canonical_port() {
  local canonical_value
  local value="$2"
  local variable="$1"
  [[ "$value" =~ ^[0-9]+$ ]] || fail "$variable must be a decimal port from 1 through 65535"

  canonical_value="$value"
  while [ "${#canonical_value}" -gt 1 ] && [ "${canonical_value:0:1}" = "0" ]; do
    canonical_value="${canonical_value:1}"
  done
  if [ "${#canonical_value}" -gt 5 ] || [ "$canonical_value" = "0" ]; then
    fail "$variable must be a decimal port from 1 through 65535"
  fi
  if [ "${#canonical_value}" -eq 5 ] && [ "$canonical_value" -gt 65535 ]; then
    fail "$variable must be a decimal port from 1 through 65535"
  fi
  printf '%s\n' "$canonical_value"
}

address_is_loopback() {
  local address="$1"
  local python_bin
  python_bin="$(python_313)"
  "$python_bin" - "$address" <<'PY'
import ipaddress
import sys

raise SystemExit(0 if ipaddress.ip_address(sys.argv[1]).is_loopback else 1)
PY
}

validate_runtime_endpoints() {
  case "$SERIAL_MODE" in
  pty)
    [ -z "${VM_X86_REDFISH_SERIAL_LISTEN_IP+x}" ] ||
      fail "VM_X86_REDFISH_SERIAL_LISTEN_IP is only valid when VM_X86_REDFISH_SERIAL_MODE=tcp"
    [ -z "${VM_X86_REDFISH_SERIAL_LISTEN_PORT+x}" ] ||
      fail "VM_X86_REDFISH_SERIAL_LISTEN_PORT is only valid when VM_X86_REDFISH_SERIAL_MODE=tcp"
    SERIAL_LISTEN_IP=""
    SERIAL_LISTEN_PORT=""
    ;;
  tcp)
    [ -n "$SERIAL_LISTEN_IP" ] ||
      fail "VM_X86_REDFISH_SERIAL_LISTEN_IP is required when VM_X86_REDFISH_SERIAL_MODE=tcp"
    [ -n "$SERIAL_LISTEN_PORT" ] ||
      fail "VM_X86_REDFISH_SERIAL_LISTEN_PORT is required when VM_X86_REDFISH_SERIAL_MODE=tcp"
    SERIAL_LISTEN_IP="$(canonical_ip_address VM_X86_REDFISH_SERIAL_LISTEN_IP "$SERIAL_LISTEN_IP")"
    SERIAL_LISTEN_PORT="$(canonical_port VM_X86_REDFISH_SERIAL_LISTEN_PORT "$SERIAL_LISTEN_PORT")"
    ;;
  *)
    fail "VM_X86_REDFISH_SERIAL_MODE must be either pty or tcp"
    ;;
  esac

  REDFISH_LISTEN_IP="$(canonical_ip_address VM_X86_REDFISH_LISTEN_IP "$REDFISH_LISTEN_IP")"
  REDFISH_LISTEN_PORT="$(canonical_port VM_X86_REDFISH_LISTEN_PORT "$REDFISH_LISTEN_PORT")"
}

format_uri_host() {
  local host="$1"
  case "$host" in
  *:*) printf '[%s]\n' "$host" ;;
  *) printf '%s\n' "$host" ;;
  esac
}

redfish_endpoint() {
  printf 'https://%s:%s\n' "$(format_uri_host "$REDFISH_LISTEN_IP")" "$REDFISH_LISTEN_PORT"
}

serial_endpoint() {
  if [ "$SERIAL_MODE" = "tcp" ]; then
    printf 'tcp://%s:%s\n' "$(format_uri_host "$SERIAL_LISTEN_IP")" "$SERIAL_LISTEN_PORT"
  else
    printf 'libvirt-console://%s/serial0\n' "$DEFAULT_DOMAIN_NAME"
  fi
}

endpoint_address_port() {
  local address="$1"
  local port="$2"
  printf '%s:%s\n' "$(format_uri_host "$address")" "$port"
}

check_listener_available() {
  local address="$1"
  local port="$2"
  local probe_port="$port"
  local probe_output
  local probe_status
  local python_bin
  local endpoint
  if integration_override_enabled && [ -n "${VM_X86_REDFISH_PORT_CHECK_PORT:-}" ]; then
    probe_port="$VM_X86_REDFISH_PORT_CHECK_PORT"
  fi
  endpoint="$(endpoint_address_port "$address" "$probe_port")"
  if integration_override_enabled; then
    case "${VM_X86_REDFISH_PORT_CHECK_RESULT:-}" in
    busy) fail "$endpoint is already in use" ;;
    available) return 0 ;;
    esac
  fi
  python_bin="$(python_313)"
  if probe_output="$("$python_bin" - "$address" "$probe_port" 2>&1 <<'PY'
import errno
import socket
import sys

try:
    address, port = sys.argv[1:]
    infos = socket.getaddrinfo(
        address,
        int(port),
        type=socket.SOCK_STREAM,
        flags=socket.AI_NUMERICHOST | socket.AI_PASSIVE,
    )
    family, socktype, protocol, _, sockaddr = infos[0]
    with socket.socket(family, socktype, protocol) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(sockaddr)
        sock.listen()
except OSError as error:
    reason = (error.strerror or "socket error").replace("\n", " ")
    print(reason)
    raise SystemExit(2 if error.errno == errno.EADDRINUSE else 1)
PY
  )"; then
    return 0
  else
    probe_status=$?
  fi
  if [ "$probe_status" -eq 2 ]; then
    fail "$endpoint is already in use"
  fi
  [ -n "$probe_output" ] || probe_output="socket error"
  fail "cannot bind $endpoint: $probe_output"
}

reject_listener_collision() {
  if [ "$SERIAL_MODE" = "tcp" ] && [ "$REDFISH_LISTEN_IP" = "$SERIAL_LISTEN_IP" ] &&
    [ "$REDFISH_LISTEN_PORT" = "$SERIAL_LISTEN_PORT" ]; then
    fail "Redfish and TCP serial listeners cannot use the same address and port"
  fi
}

warn_network_exposure() {
  if ! address_is_loopback "$REDFISH_LISTEN_IP"; then
    printf 'warning: non-loopback Redfish listener at %s\n' "$(redfish_endpoint)" >&2
  fi
  if [ "$SERIAL_MODE" = "tcp" ]; then
    printf 'warning: unauthenticated plaintext TCP serial listener at %s\n' \
      "$(serial_endpoint)" >&2
  fi
}

print_effective_endpoints() {
  local prefix="${1:-}"
  printf '%sRedfish endpoint %s\n' "$prefix" "$(redfish_endpoint)"
  printf '%sserial endpoint %s\n' "$prefix" "$(serial_endpoint)"
}

load_runtime_config() {
  reject_unguarded_override VM_X86_REDFISH_DOMAIN_NAME
  reject_unguarded_override VM_X86_REDFISH_LIBVIRT_URI
  reject_unguarded_override VM_X86_REDFISH_STORAGE_POOL
  reject_unguarded_override VM_X86_REDFISH_ROOT_VOLUME_NAME
  reject_unguarded_override VM_X86_REDFISH_STATE_DIR
  reject_unguarded_override VM_X86_REDFISH_ARTIFACTS_DIR
  DEFAULT_DOMAIN_NAME="${VM_X86_REDFISH_DOMAIN_NAME:-vm-x86-redfish}"
  LIBVIRT_URI="${VM_X86_REDFISH_LIBVIRT_URI:-qemu:///system}"
  STORAGE_POOL="${VM_X86_REDFISH_STORAGE_POOL:-default}"
  STATE_DIR="${VM_X86_REDFISH_STATE_DIR:-.state}"
  ARTIFACTS_DIR="${VM_X86_REDFISH_ARTIFACTS_DIR:-.artifacts}"
  ROOT_VOLUME_NAME="${VM_X86_REDFISH_ROOT_VOLUME_NAME:-${DEFAULT_DOMAIN_NAME}.qcow2}"
  MEMORY_MIB="${VM_X86_REDFISH_MEMORY_MIB:-4096}"
  ROOT_DISK_GIB="${VM_X86_REDFISH_ROOT_DISK_GIB:-40}"
  SOURCE_IMAGE="${VM_X86_REDFISH_SOURCE_IMAGE:-}"
  REDFISH_LISTEN_IP="${VM_X86_REDFISH_LISTEN_IP-127.0.0.1}"
  REDFISH_LISTEN_PORT="${VM_X86_REDFISH_LISTEN_PORT-8000}"
  SERIAL_MODE="${VM_X86_REDFISH_SERIAL_MODE-pty}"
  SERIAL_LISTEN_IP="${VM_X86_REDFISH_SERIAL_LISTEN_IP-}"
  SERIAL_LISTEN_PORT="${VM_X86_REDFISH_SERIAL_LISTEN_PORT-}"
  validate_runtime_endpoints
  DOMAIN_UUID_FILE="${STATE_DIR}/domain-uuid"
  LIFECYCLE_LOCK="${STATE_DIR}/lifecycle.lock"
}

load_runtime_config

reject_symlink() {
  local path="$1"
  [ ! -L "$path" ] || fail "refusing symlink: $path"
}

ensure_private_dir() {
  local path="$1"
  reject_symlink "$path"
  mkdir -p "$path"
  chmod 700 "$path"
  [ -d "$path" ] || fail "not a directory: $path"
  [ "$(stat -c '%a' "$path")" = "700" ] || fail "directory must be mode 0700: $path"
}

require_private_dir() {
  local path="$1"
  reject_symlink "$path"
  [ -d "$path" ] || fail "missing private directory: $path"
  [ "$(stat -c '%u' "$path")" = "$(id -u)" ] ||
    fail "directory must be owned by the current user: $path"
  [ "$(stat -c '%a' "$path")" = "700" ] || fail "directory must be mode 0700: $path"
}

require_private_file() {
  local path="$1"
  reject_symlink "$path"
  [ -f "$path" ] || fail "missing private file: $path"
  [ "$(stat -c '%u' "$path")" = "$(id -u)" ] ||
    fail "file must be owned by the current user: $path"
  [ "$(stat -c '%a' "$path")" = "600" ] || fail "file must be mode 0600: $path"
}

canonical_dir() {
  local path="$1"
  reject_symlink "$path"
  [ -d "$path" ] || fail "missing directory: $path"
  realpath -e "$path"
}

write_secret_file() {
  local path="$1"
  local content="$2"
  reject_symlink "$path"
  require_private_dir "$(dirname "$path")"
  umask 077
  printf '%s\n' "$content" >"$path"
  chmod 600 "$path"
}

require_safe_project_file_or_absent() {
  local path="$1"
  if [ -L "$path" ] || { [ -e "$path" ] && [ ! -f "$path" ]; }; then
    fail "unexpected project state file: $path"
  fi
}

read_domain_uuid() {
  local domain_uuid domain_uuid_regex
  require_safe_project_file_or_absent "$DOMAIN_UUID_FILE"
  [ -f "$DOMAIN_UUID_FILE" ] || fail "missing domain UUID file: $DOMAIN_UUID_FILE"
  domain_uuid="$(<"$DOMAIN_UUID_FILE")"
  domain_uuid_regex='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-'
  domain_uuid_regex+='[1-5][0-9a-fA-F]{3}-[89aAbB]'
  domain_uuid_regex+='[0-9a-fA-F]{3}-[0-9a-fA-F]{12}$'
  [[ "$domain_uuid" =~ $domain_uuid_regex ]] ||
    fail "invalid domain UUID in $DOMAIN_UUID_FILE: expected RFC 4122 UUID"
  printf '%s\n' "$domain_uuid"
}

with_lifecycle_lock() {
  local lock_path="$1"
  shift
  reject_symlink "$lock_path"
  ensure_private_dir "$(dirname "$lock_path")"
  exec 9>"$lock_path"
  flock -n 9 || fail "lifecycle lock is held: $lock_path"
  "$@"
}

xml_text_equals() {
  local xml="$1"
  local namespace="$2"
  local name="$3"
  local expected="$4"
  local python_bin
  python_bin="$(python_313)"
  "$python_bin" - "$xml" "$namespace" "$name" "$expected" <<'PY'
import sys
import xml.etree.ElementTree as ET

xml_path, namespace, name, expected = sys.argv[1:]
target = f"{{{namespace}}}{name}" if namespace else name
root = ET.parse(xml_path).getroot()
for elem in root.iter(target):
    if (elem.text or "") == expected:
        raise SystemExit(0)
raise SystemExit(1)
PY
}

xml_metadata_text_equals() {
  local xml="$1"
  local namespace="$2"
  local name="$3"
  local expected="$4"
  local python_bin
  python_bin="$(python_313)"
  "$python_bin" - "$xml" "$namespace" "$name" "$expected" <<'PY'
import sys
import xml.etree.ElementTree as ET

xml_path, namespace, name, expected = sys.argv[1:]
target = f"{{{namespace}}}{name}" if namespace else name
root = ET.parse(xml_path).getroot()
for metadata in root.findall("metadata"):
    for elem in metadata.findall(target):
        if (elem.text or "") == expected:
            raise SystemExit(0)
    container = f"{{{namespace}}}vm-x86-redfish"
    for project_metadata in metadata.findall(container):
        for elem in project_metadata.findall(target):
            if (elem.text or "") == expected:
                raise SystemExit(0)
raise SystemExit(1)
PY
}

xml_disk_source_equals() {
  local xml="$1"
  local expected="$2"
  local python_bin
  python_bin="$(python_313)"
  "$python_bin" - "$xml" "$expected" <<'PY'
import sys
import xml.etree.ElementTree as ET

xml_path, expected = sys.argv[1:]
root = ET.parse(xml_path).getroot()
for disk in root.findall(".//disk"):
    if disk.get("device") != "disk":
        continue
    source = disk.find("source")
    if source is not None and source.get("file") == expected:
        raise SystemExit(0)
raise SystemExit(1)
PY
}

domain_is_project_owned() {
  local xml="$1"
  xml_metadata_text_equals "$xml" "https://github.com/randomparity/vm-x86-redfish" \
    "project" "vm-x86-redfish"
}

domain_uuid_matches_state() {
  local xml="$1"
  local uuid
  uuid="$(read_domain_uuid)"
  xml_text_equals "$xml" "" "uuid" "$uuid"
}

domain_root_volume_matches_state() {
  local xml="$1"
  xml_metadata_text_equals "$xml" "https://github.com/randomparity/vm-x86-redfish" \
    "root-volume" "$ROOT_VOLUME_NAME"
}

domain_disk_source_matches() {
  local xml="$1"
  local root_path="$2"
  xml_disk_source_equals "$xml" "$root_path"
}

domain_config_metadata_matches() {
  local xml="$1"
  xml_metadata_text_equals "$xml" "https://github.com/randomparity/vm-x86-redfish" \
    "memory-mib" "$MEMORY_MIB" &&
    xml_metadata_text_equals "$xml" "https://github.com/randomparity/vm-x86-redfish" \
      "root-disk-gib" "$ROOT_DISK_GIB" &&
    xml_metadata_text_equals "$xml" "https://github.com/randomparity/vm-x86-redfish" \
      "source-image-sha256" "$SOURCE_IMAGE_SHA256"
}

domain_memory_matches() {
  local xml="$1"
  local python_bin
  python_bin="$(python_313)"
  "$python_bin" - "$xml" "$MEMORY_MIB" <<'PY'
import sys
import xml.etree.ElementTree as ET

xml_path, expected_mib = sys.argv[1:]
memory = ET.parse(xml_path).getroot().find("memory")
if memory is None or memory.text is None:
    raise SystemExit(1)
units = {"KiB": 1024, "MiB": 1024**2, "GiB": 1024**3}
unit = memory.get("unit", "KiB")
try:
    actual_bytes = int(memory.text) * units[unit]
except (KeyError, ValueError):
    raise SystemExit(1)
expected_bytes = int(expected_mib) * units["MiB"]
raise SystemExit(0 if actual_bytes == expected_bytes else 1)
PY
}

domain_shape_matches_expected() {
  local python_bin
  local root_path="$2"
  local xml="$1"
  python_bin="$(python_313)"
  "$python_bin" - "$xml" "$DEFAULT_DOMAIN_NAME" "$root_path" "$SERIAL_MODE" \
    "$SERIAL_LISTEN_IP" "$SERIAL_LISTEN_PORT" <<'PY'
import sys
import xml.etree.ElementTree as ET

(
    xml_path,
    domain_name,
    root_path,
    serial_mode,
    serial_listen_ip,
    serial_listen_port,
) = sys.argv[1:]
try:
    root = ET.parse(xml_path).getroot()
except ET.ParseError:
    raise SystemExit(1)

class Mismatch(Exception):
    pass


class SerialMismatch(Mismatch):
    pass


def fail():
    raise Mismatch

def require(condition):
    if not condition:
        fail()

def serial_require(condition):
    if not condition:
        raise SerialMismatch

def one(elements):
    require(len(elements) == 1)
    return elements[0]

def serial_one(elements):
    serial_require(len(elements) == 1)
    return elements[0]

def serial_children_match(parent, expected, allow_alias=False):
    alias_count = 0
    actual = {name: 0 for name in expected}
    for element in parent:
        if element.tag == "alias":
            serial_require(allow_alias)
            alias_count += 1
            serial_require(alias_count == 1)
            serial_require(element.attrib == {"name": "serial0"})
            serial_require(not list(element))
            continue
        serial_require(element.tag in actual)
        actual[element.tag] += 1
    serial_require(actual == expected)

def serial_child(parent, name, attributes):
    element = serial_one(parent.findall(name))
    serial_require(element.attrib == attributes)
    return element

def serial_leaf(parent, name, attributes):
    element = serial_child(parent, name, attributes)
    serial_require(not list(element))
    return element

def child(parent, name):
    elem = parent.find(name)
    require(elem is not None)
    return elem

def text(parent, name):
    elem = child(parent, name)
    return elem.text or ""

def domain_serial_matches(devices):
    serial = serial_one(devices.findall("serial"))
    console = serial_one(devices.findall("console"))

    if serial_mode == "pty":
        serial_require(serial.attrib == {"type": "pty"})
        serial_require(console.attrib == {"type": "pty"})
        serial_children_match(serial, {"target": 1}, allow_alias=True)
        serial_children_match(console, {"target": 1}, allow_alias=True)
    else:
        serial_require(serial_mode == "tcp")
        serial_require(serial.attrib == {"type": "tcp"})
        serial_require(console.attrib == {"type": "tcp"})
        expected_source = {
            "mode": "bind",
            "host": serial_listen_ip,
            "service": serial_listen_port,
        }
        for device in (serial, console):
            serial_children_match(
                device, {"source": 1, "protocol": 1, "target": 1}, allow_alias=True
            )
            serial_leaf(device, "source", expected_source)
            serial_leaf(device, "protocol", {"type": "raw"})

    serial_target = serial_child(serial, "target", {"type": "isa-serial", "port": "0"})
    console_target = serial_child(console, "target", {"type": "serial", "port": "0"})
    serial_children_match(serial_target, {"model": 1})
    serial_children_match(console_target, {})
    serial_leaf(serial_target, "model", {"name": "isa-serial"})

    namespace = "https://github.com/randomparity/vm-x86-redfish"
    container_tag = f"{{{namespace}}}vm-x86-redfish"
    metadata = serial_one(root.findall("metadata"))
    container = serial_one(metadata.findall(container_tag))
    serial_require(container.attrib == {})

    def metadata_matches(name, expected):
        tag = f"{{{namespace}}}{name}"
        serial_require(not metadata.findall(tag))
        element = serial_one(container.findall(tag))
        serial_require(element.attrib == {})
        serial_require(not list(element))
        serial_require((element.text or "") == expected)

    metadata_matches("serial-mode", serial_mode)
    metadata_matches("serial-listen-ip", serial_listen_ip)
    metadata_matches("serial-listen-port", serial_listen_port)

try:
    require(root.tag == "domain")
    require(root.get("type") == "kvm")
    require(text(root, "name") == domain_name)
    os_elem = child(root, "os")
    boot_entries = os_elem.findall("boot")
    require(len(boot_entries) == 1)
    require(boot_entries[0].get("dev") == "hd")
    devices = child(root, "devices")
    require(not any(True for _ in devices.iter("hostdev")))
    require(not any(True for _ in devices.iter("boot")))
    all_disks = devices.findall("disk")
    disk = one(all_disks)
    require(disk.get("type") == "file")
    require(disk.get("device") == "disk")
    driver = child(disk, "driver")
    require(driver.get("name") == "qemu")
    require(driver.get("type") == "qcow2")
    require(driver.get("discard") == "unmap")
    source = child(disk, "source")
    require(source.get("file") == root_path)
    target = child(disk, "target")
    require(target.get("dev") == "vda")
    require(target.get("bus") == "virtio")
    interface = one(devices.findall("interface"))
    require(interface.get("type") == "network")
    require(child(interface, "source").get("network") == "default")
    require(child(interface, "model").get("type") == "virtio")
    domain_serial_matches(devices)
    channel = one(devices.findall("channel"))
    channel_target = child(channel, "target")
    require(channel.get("type") == "unix")
    require(channel_target.get("type") == "virtio")
    require(channel_target.get("name") == "org.qemu.guest_agent.0")
    graphics = one(devices.findall("graphics"))
    require(graphics.get("type") == "vnc")
    listen = graphics.get("listen")
    listen_elem = graphics.find("listen")
    if listen is None and listen_elem is not None:
        listen = listen_elem.get("address")
    require(listen == "127.0.0.1")
    video_model = child(one(devices.findall("video")), "model")
    require(video_model.get("type") == "virtio")
    require(text(devices, "emulator") == "/usr/bin/qemu-system-x86_64")
except SerialMismatch:
    raise SystemExit(2)
except Mismatch:
    raise SystemExit(1)
PY
}

volume_name_for_media() {
  local image_url="$1"
  local domain_uuid="$2"
  local base
  image_url="${image_url%%\?*}"
  base="${image_url##*/}"
  base="${base//./-}"
  printf '%s-media-%s-%s.img\n' "$PROJECT_NAME" "$base" "$domain_uuid"
}
